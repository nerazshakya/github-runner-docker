# /deployment/GitHub/runner.env
# Plain KEY=VALUE format - no export, no bash syntax.
# Copy this file to /deployment/GitHub/runner.env and fill in the values.
# chmod 600 /deployment/GitHub/runner.env

# Registry
DOCKER_REGISTRY_URL=registry.example.com

# GitHub auth - PAT with admin:org scope
ACCESS_TOKEN=ghp_xxxx

# Runner registration scope
GITHUB_HOST=github.example.com
RUNNER_SCOPE=org
ORG_NAME=your-org

EPHEMERAL=false # set it to true if just to process one job and exit
DISABLE_AUTO_UPDATE=true # set it to false to enable auto update