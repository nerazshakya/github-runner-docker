# Runner configuration for deploy.sh. Plain KEY=VALUE: no export, no bash
# syntax, no inline comments. It is parsed, never executed.
# `./deploy.sh init` creates this file for you; chmod 600 the real one.
#
# IMPORTANT: keep the real file OUTSIDE any directory that is mounted into the
# runner containers (the compose file mounts /deployment into every runner).
# Suggested location: /etc/gh-runner/runner.env  (the deploy.sh default).

# --- Image --------------------------------------------------------------
# Full reference of the image CI published.
#   Docker Hub : youruser/github-runner:latest
#   Other      : registry.example.com/team/github-runner:latest
RUNNER_IMAGE=youruser/github-runner:latest

# Only for a PRIVATE image: a read-only pull credential used by deploy.sh
# (never the CI push token). Docker Hub: a Public Repo Read-only access token.
#REGISTRY_USER=youruser
#REGISTRY_TOKEN=dckr_pat_xxxx

# --- Where runners register ---------------------------------------------
# Empty/unset = github.com. For GHES set the hostname.
#GITHUB_HOST=github.example.com
# repo | org | enterprise, plus the matching value:
RUNNER_SCOPE=org
ORG_NAME=your-org
#REPO_URL=https://github.com/owner/repo
#ENTERPRISE_NAME=your-enterprise
#RUNNER_GROUP=Default

# --- GitHub credential: choose ONE --------------------------------------
# Option A: GitHub App (preferred; not tied to a person, no calendar expiry).
# APP_KEY_PATH is the .pem on THIS host. deploy.sh mounts it into the
# containers as a secret; it is never put in the environment.
#APP_ID=123456
#APP_INSTALLATION_ID=78901234
#APP_KEY_PATH=/etc/gh-runner/app-private-key.pem
# Swarm key rotation: create a new secret and name it here (see README).
#APP_KEY_SECRET_NAME=gh_app_key
#
# Option B: PAT. Fine-grained with only "Self-hosted runners: read/write"
# (org) or "Administration: read/write" (repo), or classic admin:org / repo,
# from a dedicated bot account. Remember it expires.
ACCESS_TOKEN=ghp_xxxx

# true = never self-update (rebuild the image to upgrade the runner)
DISABLE_AUTO_UPDATE=true

# Optional: host directory mounted at /deployment in every runner.
#DEPLOYMENT_DIR=/deployment

# EPHEMERAL, LABELS and RUNNER_NAME are set per environment in
# docker/docker-compose.<env>.yml, not here.
