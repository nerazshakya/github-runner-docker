# Plain KEY=VALUE format - no export, no bash syntax, no inline comments.
# chmod 600 on the real file.
#
# IMPORTANT: keep the real file OUTSIDE any directory that is mounted into the
# runner containers. The compose file mounts /deployment into every runner, so
# a copy at /deployment/GitHub/runner.env is readable by every job, including
# DEV jobs. Suggested location: /etc/gh-runner/runner.env  (pass it with -e).

# Registry
DOCKER_REGISTRY_URL=registry.example.com

# GitHub auth, choose ONE.
# Option A: GitHub App (preferred). Also create the gh_app_key Swarm secret and
# uncomment the secrets blocks in docker-compose.yml.
#APP_ID=123456
#APP_INSTALLATION_ID=78901234
# Option B: PAT. Fine-grained with only "Self-hosted runners: read/write", or
# a classic token with admin:org from a dedicated bot account.
ACCESS_TOKEN=ghp_xxxx

# Runner registration scope
GITHUB_HOST=github.example.com
RUNNER_SCOPE=org
ORG_NAME=your-org

# true = never self-update (rebuild the image to upgrade the runner)
DISABLE_AUTO_UPDATE=true

# EPHEMERAL is set per environment in docker-compose.<env>.yml, not here.
